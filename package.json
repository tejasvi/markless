{
	"name": "markless",
	"publisher": "tejasvi",
	"displayName": "Markless",
	"description": "Inline markdown preview.  Vim mode and WYSIWYG mermaid, latex and image rendering.",
	"version": "1.1.0",
	"engines": {
		"vscode": "^1.82.0"
	},
	"license": "MIT",
	"categories": [
		"Programming Languages",
		"Formatters",
		"Visualization",
		"Themes",
		"Other"
	],
	"keywords": [
		"markdown",
		"preview",
		"inline",
		"latex",
		"typora"
	],
	"author": {
		"name": "Tejasvi S. Tomar",
		"url": "https://mefyi.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/tejasvi/markless"
	},
	"icon": "assets/icon.png",
	"bugs": {
		"url": "https://github.com/tejasvi/markless"
	},
	"activationEvents": [
		"onLanguage:markdown"
	],
	"main": "./out/main.js",
	"contributes": {
		"viewsContainers": {
			"activitybar": [
				{
					"id": "markless",
					"icon": "assets/activityBar.svg",
					"title": "Markless"
				}
			]
		},
		"views": {
			"markless": [
				{
					"type": "webview",
					"id": "markless.mermaid",
					"name": "Mermaid renderer",
					"visibility": "visible"
				}
			]
		},
		"keybindings": [
			{
				"command": "markless.toggle",
				"key": "ctrl+shift+m",
				"when": "resourceLangId == markdown"
			}
		],
		"commands": [
			{
				"command": "markless.toggle",
				"title": "Toggle Inline Preview",
				"category": "Markless",
				"enablement": "resourceLangId == markdown",
				"icon": {
					"dark": "./assets/toggle.svg",
					"light": "./assets/toggle.svg"
				}
			},
			{
				"command": "markless.moveUrlsToDefinitions",
				"title": "Move Link URLs to the End of the Document",
				"category": "Markless",
				"enablement": "resourceLangId == markdown"
			}
		],
		"menus": {
			"editor/title": [
				{
					"when": "resourceLangId == markdown",
					"command": "markless.toggle",
					"group": "navigation"
				}
			]
		},
		"configuration": [
			{
				"title": "Markless",
				"properties": {
					"markless.emphasis": {
						"description": "Decorate bold, italics and strikethrough",
						"type": "boolean",
						"default": true
					},
					"markless.highlight": {
						"markdownDescription": "Highlight `==marked text==`",
						"type": "boolean",
						"default": true
					},
					"markless.heading": {
						"description": "Decorate headings",
						"type": "boolean",
						"default": true
					},
					"markless.horizontalRule": {
						"description": "Decorate horizontal rule",
						"type": "boolean",
						"default": true
					},
					"markless.inlineCode": {
						"description": "Decorate inline code",
						"type": "boolean",
						"default": true
					},
					"markless.codeBlock": {
						"description": "Decorate fenced and indented code blocks",
						"type": "boolean",
						"default": true
					},
					"markless.inlineImage.enabled": {
						"description": "Enable image preview",
						"type": "boolean",
						"default": true
					},
					"markless.inlineImage.autoPreview": {
						"description": "Preview images automatically",
						"type": "boolean",
						"default": true
					},
					"markless.mermaid": {
						"description": "Render mermaid diagrams",
						"type": "boolean",
						"default": true
					},
					"markless.latex": {
						"description": "Render LaTeX",
						"type": "boolean",
						"default": true
					},
					"markless.list": {
						"description": "Decorate lists",
						"type": "boolean",
						"default": true
					},
					"markless.listBullets": {
						"markdownDescription": "Symbols shown in place of the `-`, `*` and `+` markers of unordered list items, one per nesting level (repeating). For example `[\"•\", \"◦\", \"▪\"]`, or `[]` to keep the markers as typed. Ordered lists keep their numbers.",
						"type": "array",
						"items": {
							"type": "string"
						},
						"default": [
							"❧",
							"☯",
							"♠",
							"❀",
							"♚",
							"☬",
							"♣",
							"♥",
							"🙤",
							"⚜",
							"⚛",
							"⛇",
							"⚓",
							"☘",
							"☔"
						]
					},
					"markless.quote": {
						"description": "Decorate quotes",
						"type": "boolean",
						"default": true
					},
					"markless.table": {
						"description": "Render tables",
						"type": "boolean",
						"default": true
					},
					"markless.html": {
						"description": "Decorate HTML tags",
						"type": "boolean",
						"default": true
					},
					"markless.link": {
						"description": "Decorate link and image urls",
						"type": "boolean",
						"default": true
					},
					"markless.hoverImage": {
						"description": "Preview image on hover",
						"type": "boolean",
						"default": true
					},
					"markless.cursorDisables": {
						"description": "Disable concealment around the cursor and selection",
						"type": "boolean",
						"default": true
					}
				}
			}
		],
		"colors": [
			{
				"id": "markless.highlightBackground",
				"description": "Background of ==highlighted== text",
				"defaults": {
					"dark": "#ffd70040",
					"light": "#fff20080",
					"highContrast": "#ffd70066",
					"highContrastLight": "#fff20080"
				}
			}
		]
	},
	"dependencies": {
		"hast-util-to-html": "^9.0.5",
		"mathjax-full": "^3.2.2",
		"mdast-util-to-hast": "^13.2.1",
		"mdast-util-to-string": "^4.0.0",
		"mermaid": "^11.17.2",
		"remark-frontmatter": "^5.0.0",
		"remark-gfm": "^4.0.1",
		"remark-highlight-mark": "^1.4.0",
		"remark-math": "^6.0.0",
		"remark-parse": "^11.0.0",
		"unified": "^11.0.5"
	},
	"scripts": {
		"lint": "eslint src test",
		"pretest": "npm run lint && npm run esbuild",
		"test": "mocha --ui tdd test/unit && node ./test/runTest.js",
		"vscode:prepublish": "npm run -S esbuild-base -- --minify",
		"esbuild-base": "node -e \"require('fs').mkdirSync('out',{recursive:true});require('fs').copyFileSync(require.resolve('mermaid/dist/mermaid.min.js'),'out/mermaid.min.js')\" && esbuild ./src/extension.js --bundle --outfile=out/main.js --external:vscode --format=cjs --platform=node --target=node18",
		"esbuild": "npm run -S esbuild-base -- --sourcemap",
		"esbuild-watch": "npm run -S esbuild-base -- --sourcemap --watch",
		"package": "vsce package --no-dependencies"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/mocha": "^10.0.10",
		"@types/node": "^26.6.5",
		"@types/vscode": "^1.82.0",
		"@vscode/test-electron": "^3.1.0",
		"@vscode/vsce": "^4.0.0",
		"esbuild": "^0.28.2",
		"eslint": "^10.13.0",
		"globals": "^17.13.0",
		"mocha": "^12.0.3"
	},
	"__metadata": {
		"id": "31b769d3-ba13-4af3-a7e8-5257e0df28b1",
		"publisherDisplayName": "Tejasvi S. Tomar",
		"publisherId": "48cdae1f-c60f-474f-95a2-86dd106fcb49"
	}
}
